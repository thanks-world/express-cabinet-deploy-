version: "3.8"

services:
  prometheus:
    image: prom/prometheus:v2.51.0
    container_name: cabinet-prometheus
    restart: unless-stopped
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
    depends_on:
      - alertmanager
    networks:
      - cabinet-net

  alertmanager:
    image: prom/alertmanager:v0.27.0
    container_name: cabinet-alertmanager
    restart: unless-stopped
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    ports:
      - "9093:9093"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - cabinet-net

  node-exporter:
    image: prom/node-exporter:v1.8.0
    container_name: cabinet-node-exporter
    restart: unless-stopped
    pid: host
    security_opt:
      - label:disable
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    ports:
      - "9100:9100"
    networks:
      - cabinet-net

  nginx-exporter:
    image: nginx/nginx-prometheus-exporter:1.5.1
    container_name: cabinet-nginx-exporter
    restart: unless-stopped
    command:
      - "--nginx.scrape-uri=http://cabinet-nginx:80/stub_status"
    ports:
      - "9113:9113"
    networks:
      - cabinet-net

  blackbox-exporter:
    image: prom/blackbox-exporter:v0.25.0
    container_name: cabinet-blackbox-exporter
    restart: unless-stopped
    volumes:
      - ./blackbox/blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    ports:
      - "9115:9115"
    networks:
      - cabinet-net

  cabinet-exporter:
    build: ./exporter
    container_name: cabinet-exporter
    restart: unless-stopped
    ports:
      - "9101:9101"
    networks:
      - cabinet-net

networks:
  cabinet-net:
    external: true
    name: cabinet-net

volumes:
  prometheus-data:
